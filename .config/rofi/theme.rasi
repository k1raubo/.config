* {
    font:   "Montserrat 12";
    bg0:    #161616F2;
    bg1:    #262626CC;
    bg2:    #3A3A3AFF;
    fg0:    #CDD6F4;
    fg1:    #FFFFFF;
    fg2:    #6C7086;
    background-color:   transparent;
    text-color:         @fg0;
    margin:     0; 
    padding:    0;
    spacing:    0; 
}
window {
    background-color:   @bg0;
    location:       center;
    width:          640;
    border-radius:  16px;
}
mainbox {
    background-color:   transparent;
    border-radius:       16px;
    children:            [ inputbar, message, listview ];
}
inputbar {
    font:       "Montserrat 20";
    padding:    12px;
    spacing:    12px;
    border-radius: 16px 16px 0px 0px;
    children:   [ icon-search, entry ];
}
icon-search {
    expand:     false;
    filename:   "search";
    size: 28px;
}
icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}
entry {
    font:   inherit;
    placeholder         : "Search";
    placeholder-color   : @fg2;
}
message {
    border:             2px 0 0;
    border-color:       @bg1;
    background-color:   @bg1;
}
textbox {
    padding:    8px 24px;
}
listview {
    lines:      7;
    columns:    1;
    fixed-height:   false;
    border:       1px 0 0;
    border-color:   @bg1;
    border-radius: 0px 0px 16px 16px;
}
element {
    padding:            8px 16px;
    spacing:            16px;
    background-color:   transparent;
    border-radius:       10px;
}
element normal active {
    text-color: #89B4FA;
}
element alternate active {
    text-color: #89B4FA;
}
element selected normal, element selected active {
    background-color:   @bg2;
    text-color:         #CDD6F4;
}
element-icon {
    size:   1em;
}
element-text {
    text-color: inherit;
}
